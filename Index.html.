<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#101827">
<title>Zyy</title>
<style>
:root{color-scheme:dark;--bg:#101827;--panel:#192437;--line:#2b3a52;--accent:#8bafff;--text:#f4f7ff;--muted:#aebbd0}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
main{max-width:620px;margin:auto;min-height:100svh;padding:24px 16px calc(24px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:16px}
header{padding:10px 4px}h1{font-size:32px;margin:0 0 5px}header p{margin:0;color:var(--muted)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:16px}
#chat{height:42svh;min-height:260px;overflow:auto;display:flex;flex-direction:column;gap:10px}
.msg{padding:11px 13px;border-radius:15px;max-width:88%;line-height:1.4;white-space:pre-wrap}
.bot{background:#26364f;align-self:flex-start}.you{background:#36558b;align-self:flex-end}
form{display:flex;gap:8px;margin-top:12px}input,textarea{width:100%;background:#101a2a;border:1px solid var(--line);border-radius:12px;color:var(--text);padding:13px;font:inherit;min-width:0}
button{border:0;border-radius:12px;background:var(--accent);color:#101827;font-weight:700;padding:0 16px;font-size:15px}
.tools{display:flex;gap:8px;flex-wrap:wrap}.tools button{padding:11px 13px}
h2{font-size:18px;margin:0 0 10px}small{color:var(--muted)}
#notes{min-height:74px;resize:vertical}#status{color:var(--muted);font-size:13px}
</style>
</head>
<body>
<main>
<header><h1>Zyy</h1><p>Your simple personal helper.</p></header>
<section class="panel">
  <div id="chat" aria-live="polite">
    <div class="msg bot">Hi! I'm Zyy. I can chat, help you plan a task, and keep a note on this phone. What would you like to do?</div>
  </div>
  <form id="chatForm"><input id="message" placeholder="Message Zyy…" autocomplete="off" aria-label="Message Zyy"><button>Send</button></form>
  <div class="tools">
    <button type="button" id="voice">🎙 Speak</button>
    <button type="button" id="clear">Clear chat</button>
  </div>
  <div id="status">Voice availability depends on your browser.</div>
</section>
<section class="panel">
  <h2>My notes</h2>
  <textarea id="notes" placeholder="Write something you want Zyy to keep on this phone…"></textarea>
  <small id="saved">Notes save on this device when you type.</small>
</section>
</main>
<script>
const chat=document.getElementById('chat'), input=document.getElementById('message'), notes=document.getElementById('notes'), status=document.getElementById('status');
try{notes.value=localStorage.getItem('zyy_notes')||'';}catch(e){}
notes.addEventListener('input',()=>{try{localStorage.setItem('zyy_notes',notes.value);document.getElementById('saved').textContent='Saved on this device.';}catch(e){document.getElementById('saved').textContent='Local saving is unavailable in this browser.';}});
function add(text,who){const d=document.createElement('div');d.className='msg '+who;d.textContent=text;chat.appendChild(d);chat.scrollTop=chat.scrollHeight;}
function reply(s){
 const t=s.toLowerCase();
 if(/\b(hello|hi|hey)\b/.test(t)) return 'Hey! What would you like to work on today?';
 if(t.includes('time')||t.includes('date')) return 'You can check the time and date at the top of your iPhone. I do not have live access to your clock in this basic version.';
 if(t.includes('note')||t.includes('remember')) return 'Add it in the My notes box below. It is saved in this browser on this phone.';
 if(t.includes('plan')||t.includes('task')||t.includes('today')) return 'Let’s make it easy: tell me the one thing you need to get done first, and I’ll help break it into small steps.';
 if(t.includes('who are you')) return 'I’m Zyy, your simple personal helper.';
 return 'I’m here. I’m the first basic version of Zyy, so I can respond to a few simple requests but I’m not connected to an online AI yet. Tell me what you need, and we can build it up one small step at a time.';
}
document.getElementById('chatForm').addEventListener('submit',e=>{e.preventDefault();const s=input.value.trim();if(!s)return;add(s,'you');input.value='';add(reply(s),'bot');});
document.getElementById('clear').addEventListener('click',()=>{chat.innerHTML='';add('Chat cleared. What would you like help with?','bot');});
document.getElementById('voice').addEventListener('click',()=>{
 const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!SR){status.textContent='Speech input is not available in this browser. You can still type messages.';return;}
 const r=new SR();r.lang='en-US';r.onresult=e=>{input.value=e.results[0][0].transcript;input.focus();};r.onerror=()=>status.textContent='Voice input did not start. Please type your message instead.';r.start();status.textContent='Listening…';
});
</script>
</body></html>